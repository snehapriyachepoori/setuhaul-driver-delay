# Copy this file to .env and fill in the values. Never commit .env.
MODEL_ROUTE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OLLAMA_MODEL=qwen3:8b
COORDINATOR_PIN=

# --- LangSmith tracing (optional, bonus E5). Leave LANGSMITH_TRACING=false to switch it off. ---
# Names from docs.langchain.com/langsmith (read 27 Nov 2026). Never commit a real key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=setuhaul-driver-delay
LANGSMITH_AGENT_ENVIRONMENT=local
# Only if your LangSmith account is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
